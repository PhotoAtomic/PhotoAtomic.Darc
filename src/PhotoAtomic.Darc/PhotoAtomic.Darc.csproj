<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Enable Orleans source generators -->
    <GenerateOrleansCode>true</GenerateOrleansCode>

    <!-- NuGet package metadata -->
    <IsPackable>true</IsPackable>
    <PackageId>PhotoAtomic.Darc</PackageId>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Authors>PhotoAtomic</Authors>
    <Company>PhotoAtomic</Company>
    <Product>PhotoAtomic.Darc</Product>
    <Description>Transactional state storage for Microsoft Orleans backed by KurrentDB (EventStoreDB). Implements ITransactionalStateStorage with both optimistic and pessimistic concurrency strategies.</Description>
    <PackageTags>Orleans;KurrentDB;EventStore;Transactions;EventSourcing;Grains;Distributed</PackageTags>
    <PackageProjectUrl>https://github.com/PhotoAtomic/PhotoAtomic.Darc</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PhotoAtomic/PhotoAtomic.Darc</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Bundle the Clooney source generator (and its dependencies) into this package so that
         consumers that reference only the PhotoAtomic.Darc package get [Clonable] code generation
         without having to reference the Clooney source projects. See _AddClooneyGeneratorToPackage. -->
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddClooneyGeneratorToPackage</TargetsForTfmSpecificContentInPackage>
    <!-- The package intentionally ships analyzer assemblies alongside lib assemblies. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\PhotoAtomic.Darc\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build-time only: Orleans source generator SDK, not needed by consumers -->
    <PackageReference Include="Microsoft.Orleans.Sdk" Version="10.1.0" PrivateAssets="all" />
    <!-- Runtime dependencies: consumers must have these installed -->
    <PackageReference Include="Microsoft.Orleans.Transactions" Version="10.1.0" />
    <PackageReference Include="KurrentDB.Client" Version="1.4.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <!-- PhotoAtomic.Clooney is a Roslyn source generator: used only at compile-time, not shipped in the output assembly -->
    <ProjectReference Include="..\PhotoAtomic.Clooney\PhotoAtomic.Clooney.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <!-- PhotoAtomic.Clooney.Abstractions contains attribute types referenced in Darc's code: bundled into the output, not exposed as a NuGet dependency -->
    <ProjectReference Include="..\PhotoAtomic.Clooney.Abstractions\PhotoAtomic.Clooney.Abstractions.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- Adds the Clooney Roslyn source generator and its runtime dependencies to the NuGet package.
       The generator + its dependencies go under analyzers/dotnet/cs so Roslyn loads them in consumer
       projects. The Clooney assembly (which defines [Clonable]/[Diffable]/[Hashable] and the
       Clone/Diff/Hash context types) and the abstractions assembly (which defines [SkipClone],
       IClonable, etc.) are ALSO placed under lib so consumer code can reference those public types at
       compile time — an analyzer-only assembly is not referenceable. -->
  <Target Name="_AddClooneyGeneratorToPackage">
    <PropertyGroup>
      <_ClooneyBin>$(MSBuildThisFileDirectory)..\PhotoAtomic.Clooney\bin\$(Configuration)\netstandard2.0</_ClooneyBin>
      <_IndentedBin>$(MSBuildThisFileDirectory)..\PhotoAtomic.IndentedStrings\bin\$(Configuration)\netstandard2.0</_IndentedBin>
      <_AbstractionsBin>$(MSBuildThisFileDirectory)..\PhotoAtomic.Clooney.Abstractions\bin\$(Configuration)\netstandard2.0</_AbstractionsBin>
    </PropertyGroup>
    <Error Condition="!Exists('$(_ClooneyBin)\PhotoAtomic.Clooney.dll')"
           Text="Clooney generator not found at '$(_ClooneyBin)\PhotoAtomic.Clooney.dll'. Build the solution in $(Configuration) before packing." />
    <ItemGroup>
      <!-- Source generator + dependencies into the analyzer path -->
      <TfmSpecificPackageFile Include="$(_ClooneyBin)\PhotoAtomic.Clooney.dll" PackagePath="analyzers/dotnet/cs" />
      <TfmSpecificPackageFile Include="$(_IndentedBin)\PhotoAtomic.IndentedStrings.dll" PackagePath="analyzers/dotnet/cs" />
      <TfmSpecificPackageFile Include="$(_AbstractionsBin)\PhotoAtomic.Clooney.Abstractions.dll" PackagePath="analyzers/dotnet/cs" />
      <!-- Clooney + Abstractions assemblies also into lib so consumer code can use the attribute types
           ([Clonable]/[Diffable]/[Hashable] live in PhotoAtomic.Clooney; [SkipClone] in Abstractions). -->
      <TfmSpecificPackageFile Include="$(_ClooneyBin)\PhotoAtomic.Clooney.dll" PackagePath="lib/$(TargetFramework)" />
      <TfmSpecificPackageFile Include="$(_AbstractionsBin)\PhotoAtomic.Clooney.Abstractions.dll" PackagePath="lib/$(TargetFramework)" />
    </ItemGroup>
  </Target>

</Project>
